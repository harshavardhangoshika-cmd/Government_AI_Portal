# ============================================================
# STREAMLIT COMMUNITY CLOUD SECRETS CONFIGURATION TEMPLATE
# ============================================================
# Do NOT commit your actual secrets.toml to GitHub.
# Copy the lines below into your Streamlit Cloud Dashboard:
# App Settings -> Secrets

# Supabase Database Configuration (Required for live DB persistence & tracking)
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-supabase-anon-or-service-key"

# Optional External FastAPI Backend URL (Leave commented to run in-process)
# API_URL = "https://your-api-domain.onrender.com"
