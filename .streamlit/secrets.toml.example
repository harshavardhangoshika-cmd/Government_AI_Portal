# ============================================================
# Streamlit Community Cloud Secrets Configuration Template
# Paste these keys into: Share.streamlit.io -> App Settings -> Secrets
# ============================================================

# Supabase PostgreSQL Database Credentials
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-anon-or-publishable-key"

# Dedicated FastAPI Cloud Backend (Optional)
# If you host the FastAPI backend separately on Render, Railway, Fly.io, etc.
# Paste the public HTTPS URL of your deployed backend here:
API_BASE_URL = "https://your-government-ai-backend.onrender.com"
